SELECT ?molecule ?moleculeLabel ?molWeight ?formula ?image ?roleLabel WHERE {
  VALUES ?molecule { 
    wd:Q167934   # Serotonin
    wd:Q407217   # DMT
    wd:Q409150   # Psilocin
    wd:Q207833   # Mescaline
    wd:Q24701    # MDMA
    wd:Q415997   # Ketanserin
  }
  
  ?molecule wdt:P2067 ?molWeight.
  ?molecule wdt:P274 ?formula.
  ?molecule wdt:P117 ?image.
  ?molecule wdt:P2868 ?role.
  
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
